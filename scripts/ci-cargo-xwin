#!/usr/bin/env bash
# cargo-xwin 0.20.2 (nixpkgs' version) with one change to the xwin it uses:
# Microsoft's manifest no longer lists a per-architecture "Desktop Headers"
# installer for SDK 10.0.26100 (it held next to nothing; x86's carries the
# headers), and xwin 0.6.7 stopped on its absence. This build skips it.
# Installs to $1/bin; put that first on PATH so `cargo xwin` finds it.
set -euo pipefail
dest=${1:?usage: scripts/ci-cargo-xwin DEST}
work=$(mktemp -d)
curl -sSfL https://static.crates.io/crates/cargo-xwin/cargo-xwin-0.20.2.crate | tar xz -C "$work"
cd "$work/cargo-xwin-0.20.2"
cargo fetch --locked
src=$(ls -d "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/xwin-0.6.7 | head -1)
python3 - "$src/src/lib.rs" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
old = '.with_context(|| format!("unable to find {arch} headers for {}", sdk.id))?;'
new = ';\n            let Some(header_payload) = header_payload else { continue };'
assert s.count(old) == 1, 'xwin source changed'
open(p, 'w').write(s.replace(old, new))
PY
cargo install --locked --offline --path . --root "$dest"
